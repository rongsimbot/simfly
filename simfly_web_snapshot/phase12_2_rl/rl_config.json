{
    "training": {
        "total_episodes": 60,
        "buffer_size": 8,
        "print_freq": 5,
        "save_dir": "./results"
    },
    "ppo": {
        "clip_epsilon": 0.2,
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "entropy_coef": 0.005,
        "value_coef": 0.5,
        "max_grad_norm": 0.5,
        "epochs": 4,
        "batch_size": 4,
        "learning_rate": 5e-4
    },
    "policy": {
        "network_type": "small",
        "hidden_size": 128
    },
    "environment": {
        "base_url": "http://192.168.1.199:8080",
        "global_gain": 0.001,
        "tau_decay": 100.0,
        "stabilize_seconds": 5.0,
        "sample_steps": 15,
        "sample_interval": 0.15,
        "cv_weight": 10.0,
        "food_weight": 5.0,
        "sat_penalty": 1.0
    }
}
